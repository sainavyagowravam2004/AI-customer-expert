# Copy to .env. Hostnames below resolve inside Docker Compose.
# From the host machine, use localhost for Postgres and
# http://127.0.0.1:11434 for Ollama.
# Leave S3_ENDPOINT_URL empty to store files on STORAGE_DIR
# (/app/storage, the knowledge_assets volume).

APP_NAME=AI Customer Expert
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_customer_expert
PROCRASTINATE_DSN=postgresql://postgres:postgres@db:5432/ai_customer_expert

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=knowledge-assets
S3_REGION=us-east-1
STORAGE_DIR=/app/storage

OLLAMA_BASE_URL=http://host.docker.internal:11434

SECRET_KEY=change-me-in-production
